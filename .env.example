# Copy to .env. Every value below has a local-only default in docker-compose.yml,
# so the stack boots without a .env. Change them anywhere that is not your laptop.

# Superset
# Generate with: openssl rand -base64 42. Keep comments on their own line:
# Compose reads "KEY=   # note" as the value "# note".
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SERVICE_USERNAME=holotable_svc   # read-only account for the API and MCP server
SUPERSET_SERVICE_PASSWORD=holotable_svc

# Postgres (Superset metadata, example data, holotable schema)
POSTGRES_USER=superset
POSTGRES_PASSWORD=superset

# LLM for the agent. Only LLM_API_KEY is required.
# LLM_PROVIDER: anthropic, ollama or openai-compatible (any Chat Completions API;
# for OpenCode Go set LLM_BASE_URL=https://opencode.ai/inference/go/openai/v1)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
LLM_BASE_URL=
# Anthropic effort: low, medium, high, xhigh or max
LLM_EFFORT=medium
# Seconds before an agent run stops; raise it for local models
AGENT_TIME_LIMIT=180

# Local models (profile local-llm): LLM_PROVIDER=ollama, LLM_MODEL=qwen3.5:35b.
# Set OLLAMA_MODELS=$HOME/.ollama to reuse models Ollama already has.
OLLAMA_MODELS=
